# Copy this file to .env and fill in your values. Never commit .env (it is in .gitignore).
# On Ninoo, set the same names as environment variables instead of using a file.

# --- Nicrron (AI drafts). Default model: Claude Sonnet 5.5 ---
NICRRON_API_KEY=
NICRRON_MODEL=anthropic/claude-sonnet-5-5
# Models the website may ask for (comma-separated). The first one is the default.
NICRRON_MODELS=anthropic/claude-sonnet-5-5

# --- Backend safety (live model drafts spend your Nicrron credits) ---
# Anyone using the website's "Redraft" button must type this code. Pick something long.
DEMO_ACCESS_CODE=
# Sites allowed to call the backend from a browser.
ALLOWED_ORIGINS=https://ns-programmer.github.io
MODEL_CALLS_PER_MINUTE=10

# --- Chat assistant (/api/assistant): rules (default) or nicrron (live answers, checked by code) ---
ASSISTANT_MODE=rules
ASSISTANT_CALLS_PER_MINUTE=30

# --- Whole-queue drafter for the backend: template (default) or nicrron ---
DRAFTER=template

# --- PRISM by Block Convey (tracing + testing). Tracing is off until both are set ---
# Key: PRISM > Settings > API keys (starts with pt-sk-, shown once). Project: Settings > Project (a UUID).
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Optional: make PRISM's "Test your AI" send `Authorization: Bearer <this>` to /api/assistant.
# Leave blank to keep the chat endpoint open (simulated data only).
ASSISTANT_API_KEY=
